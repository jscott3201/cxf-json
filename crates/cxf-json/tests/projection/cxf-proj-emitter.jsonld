      "S231P:graphics": "Placement(transformation(extent={{-60,-50},{-40,-30}}))",
      "S231P:hasInstance": [
        { "@id": "ex:Project.RootBlock.gain.k" },
        { "@id": "ex:Project.RootBlock.gain.u" },
        { "@id": "ex:Project.RootBlock.gain.y" }
